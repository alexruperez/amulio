AMULIO_PUBLIC_URL=https://amulio.example.com
CADDY_DOMAIN=amulio.example.com
CADDY_EMAIL=admin@example.com
AMULIO_INSTALL_TOKEN=replace-with-a-long-random-install-token
AMULIO_TOKEN_SECRET=replace-with-a-long-random-signing-secret
# Optional: enables the built-in profile administration API. Keep this separate
# from the Stremio manifest token and store it in a private secret manager.
# AMULIO_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
# Leave unset to keep /metrics disabled. If set, scrape with Authorization: Bearer <token>.
# AMULIO_METRICS_TOKEN=replace-with-a-separate-long-random-metrics-token
AMULIO_ALLOWED_MEDIA_ROOTS=/data/incoming
AMULE_API_BASE_URL=http://amuleapi:4713/api/v0
# aMulio reads this Docker secret at AMULE_API_ADMIN_PASSWORD_FILE.
AMULE_EC_PASSWORD_FILE=./secrets/amule_ec_password
AMULEAPI_ADMIN_PASSWORD_FILE=./secrets/amuleapi_admin_password
AMULIO_METADATA_CACHE_TTL_SECONDS=3600
AMULIO_PREFERRED_LANGUAGES=en,es
AMULIO_ALLOWED_VIDEO_EXTENSIONS=.avi,.m4v,.mkv,.mov,.mp4,.mpeg,.mpg,.ts,.webm
AMULIO_DENIED_FILE_EXTENSIONS=.exe,.iso,.rar,.zip
AMULIO_ALLOW_SEASON_PACKS=false
AMULIO_SEARCH_QUERY_LIMIT=3
AMULIO_SEARCH_TIMEOUT_SECONDS=15
AMULIO_NEGATIVE_CANDIDATE_TTL_SECONDS=120
# Per installation-token and client-IP limits within the window below.
AMULIO_RATE_LIMIT_WINDOW_SECONDS=60
AMULIO_ADMIN_LOGIN_RATE_LIMIT=10
AMULIO_MANIFEST_RATE_LIMIT=30
AMULIO_STREAM_RATE_LIMIT=30
AMULIO_PLAYBACK_RATE_LIMIT=600
