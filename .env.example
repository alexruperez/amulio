AMULIO_PUBLIC_URL=https://amulio.example.com
AMULIO_INSTALL_TOKEN=replace-with-a-long-random-install-token
AMULIO_TOKEN_SECRET=replace-with-a-long-random-signing-secret
AMULIO_ALLOWED_MEDIA_ROOTS=/data/incoming
AMULE_API_BASE_URL=http://amuleapi:4713/api/v0
AMULE_API_ADMIN_PASSWORD=replace-with-amuleapi-admin-password
AMULIO_METADATA_CACHE_TTL_SECONDS=3600
AMULIO_PREFERRED_LANGUAGES=en,es
AMULIO_SEARCH_QUERY_LIMIT=3
AMULIO_SEARCH_TIMEOUT_SECONDS=15
AMULIO_NEGATIVE_CANDIDATE_TTL_SECONDS=120
